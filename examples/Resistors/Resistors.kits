  pad: '1'
  current_a: 1.0
- ref: R2
  pad: '1'
  current_a: -0.5
- ref: R1
  pad: '1'
  current_a: -0.5
- ref: R2
  pad: '2'
  current_a: 0.5
- ref: R1
  pad: '2'
  current_a: 0.5
- ref: R3
  pad: '1'
  current_a: -1.0
- ref: R3
  pad: '2'
  current_a: 1.0
- ref: J2
  pad: '1'
  current_a: -1.0
