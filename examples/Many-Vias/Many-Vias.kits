board: Many-Vias.kicad_pro
mesh:
  max_size_mm: 0.25
  min_size_mm: 0.05
  min_circle_points: 36
  corner_size_mm: 0.05
ambient_temperature_c: 24.0
materials:
  copper:
    conductivity_s_m: 58000000.0
    thermal_conductivity_w_mk: 390.0
    plating_thickness_mm: 0.025
  dielectric:
    thermal_conductivity_w_mk: 0.3
  solder_mask:
    thermal_conductivity_w_mk: 0.25
  via_fill:
    type: none
    thermal_conductivity_w_mk: 0.3
convection:
  top_w_m2k: 14.0
  bottom_w_m2k: 10.0
current_multiplier: 2.0
current_sources:
- ref: J1
  pad: '1'
  current_a: 10.0
- ref: J2
  pad: '1'
  current_a: -10.0
heatsinks:
- name: HS1
  side: bottom
  x_mm: 96.0
  y_mm: 80.0
  width_mm: 10.0
  height_mm: 12.0
  thermal_resistance_board_k_w: 1.0
  thermal_resistance_ambient_k_w: 10.0
  mount: components
  enabled: false
resistive_elements:
- name: R1
  ref: R1
  resistance_ohm: 0.001
  pads_a:
    name: /IN
    pads:
    - '1'
  pads_b:
    name: /OUT
    pads:
    - '2'
